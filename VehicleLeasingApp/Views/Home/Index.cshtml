@model VehicleLeasingApp.Controllers.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    var total = Model.TotalVehicles == 0 ? 1 : Model.TotalVehicles;
    var availPct = (int)Math.Round((double)Model.AvailableVehicles / total * 100);
    var leasedPct = (int)Math.Round((double)Model.LeasedVehicles / total * 100);
}

<div class="content-header" data-reveal>
    <h1>Fleet Overview</h1>
</div>

<!-- ===== STAT STRIP ===== -->
<div class="stat-strip">
    <div class="stat-cell k-red" data-reveal>
        <div class="tag"><i class="material-icons">directions_car</i> Total Vehicles</div>
        <div class="big" data-count="@Model.TotalVehicles">0</div>
        <div class="sub">Fleet size on record</div>
        <div class="bar"><span style="width:100%"></span></div>
    </div>
    <div class="stat-cell k-green" data-reveal>
        <div class="tag"><i class="material-icons">check_circle</i> Available</div>
        <div class="big" data-count="@Model.AvailableVehicles">0</div>
        <div class="sub">@availPct% ready for lease</div>
        <div class="bar"><span style="width:@(availPct)%"></span></div>
    </div>
    <div class="stat-cell k-amber" data-reveal>
        <div class="tag"><i class="material-icons">swap_horiz</i> Leased</div>
        <div class="big" data-count="@Model.LeasedVehicles">0</div>
        <div class="sub">@leasedPct% currently in use</div>
        <div class="bar"><span style="width:@(leasedPct)%"></span></div>
    </div>
    <div class="stat-cell k-blue" data-reveal>
        <div class="tag"><i class="material-icons">store</i> Branches</div>
        <div class="big" data-count="@Model.TotalBranches">0</div>
        <div class="sub">@Model.TotalSuppliers suppliers · @Model.TotalClients clients</div>
        <div class="bar"><span style="width:100%"></span></div>
    </div>
</div>

<!-- ===== ANALYTICS ===== -->
<div class="analytics-grid" data-reveal>
    <!-- By Manufacturer -->
    <div class="analytics-cell">
        <div class="ac-title">By Manufacturer <span>UNITS / RATE</span></div>
        <table class="data-table">
            <thead>
                <tr><th>Manufacturer</th><th>Total</th><th>Avail.</th><th>Daily Rate</th></tr>
            </thead>
            <tbody>
                @foreach (var stat in Model.VehicleStatsByManufacturer)
                {
                    <tr>
                        <td><strong>@stat.Manufacturer</strong></td>
                        <td><span class="label label-primary">@stat.TotalVehicles</span></td>
                        <td><span class="label label-success">@stat.AvailableVehicles</span></td>
                        <td><span class="rate">R@(stat.TotalDailyRate.ToString("F2"))</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- By Supplier -->
    <div class="analytics-cell">
        <div class="ac-title">By Supplier <span>UNITS / RATE</span></div>
        <table class="data-table">
            <thead>
                <tr><th>Supplier</th><th>Total</th><th>Avail.</th><th>Daily Rate</th></tr>
            </thead>
            <tbody>
                @foreach (var stat in Model.VehicleStatsBySupplier)
                {
                    <tr>
                        <td><strong>@stat.SupplierName</strong></td>
                        <td><span class="label label-primary">@stat.TotalVehicles</span></td>
                        <td><span class="label label-success">@stat.AvailableVehicles</span></td>
                        <td><span class="rate">R@(stat.TotalDailyRate.ToString("F2"))</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- By Branch -->
    <div class="analytics-cell">
        <div class="ac-title">By Branch Location <span>UNITS / RATE</span></div>
        <table class="data-table">
            <thead>
                <tr><th>Branch</th><th>Total</th><th>Avail.</th><th>Daily Rate</th></tr>
            </thead>
            <tbody>
                @foreach (var stat in Model.VehicleStatsByBranch)
                {
                    <tr>
                        <td><strong>@stat.BranchName</strong></td>
                        <td><span class="label label-primary">@stat.TotalVehicles</span></td>
                        <td><span class="label label-success">@stat.AvailableVehicles</span></td>
                        <td><span class="rate">R@(stat.TotalDailyRate.ToString("F2"))</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- By Client -->
    <div class="analytics-cell">
        <div class="ac-title">By Client <span>UNITS / RATE</span></div>
        <table class="data-table">
            <thead>
                <tr><th>Client Company</th><th>Vehicles</th><th>Daily Rate</th></tr>
            </thead>
            <tbody>
                @foreach (var stat in Model.VehicleStatsByClient)
                {
                    <tr>
                        <td><strong>@stat.ClientName</strong></td>
                        <td><span class="label label-warning">@stat.TotalVehicles</span></td>
                        <td><span class="rate">R@(stat.TotalDailyRate.ToString("F2"))</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== QUICK ACTIONS ===== -->
<div class="management-actions-container" data-reveal>
    <div class="management-header">
        <h3>Quick Actions</h3>
        <p>// jump to a module</p>
    </div>
    <div class="management-grid">
        <a href="/Vehicles/Index" class="management-card featured">
            <span class="card-icon"><i class="material-icons">directions_car</i></span>
            <span class="card-content"><h4>Vehicles</h4><p>Fleet inventory</p></span>
        </a>
        <a href="/Suppliers/Index" class="management-card">
            <span class="card-icon"><i class="material-icons">business</i></span>
            <span class="card-content"><h4>Suppliers</h4><p>Vendor records</p></span>
        </a>
        <a href="/Branches/Index" class="management-card">
            <span class="card-icon"><i class="material-icons">store</i></span>
            <span class="card-content"><h4>Branches</h4><p>Locations</p></span>
        </a>
        <a href="/Clients/Index" class="management-card">
            <span class="card-icon"><i class="material-icons">people</i></span>
            <span class="card-content"><h4>Clients</h4><p>Customer records</p></span>
        </a>
        <a href="/Drivers/Index" class="management-card">
            <span class="card-icon"><i class="material-icons">person</i></span>
            <span class="card-content"><h4>Drivers</h4><p>Driver records</p></span>
        </a>
        <a href="/Vehicles/Create" class="management-card">
            <span class="card-icon"><i class="material-icons">add</i></span>
            <span class="card-content"><h4>Add Vehicle</h4><p>Register new</p></span>
        </a>
    </div>
</div>
