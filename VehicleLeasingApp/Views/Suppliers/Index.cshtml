@model IEnumerable<VehicleLeasingApp.Models.Supplier>

@{
    ViewBag.Title = "Suppliers";
}

<div class="page-header-clean" data-reveal>
    <div class="header-content">
        <h1>Suppliers</h1>
        <div class="header-actions">
            @Html.ActionLink("+ Add Supplier", "Create", null, new { @class = "btn btn-primary" })
        </div>
    </div>
</div>

<div class="fleet-summary" data-reveal>
    <div class="summary-item">
        <span class="number">@Model.Count()</span>
        <span class="label">Total Suppliers</span>
    </div>
    <div class="summary-item">
        <span class="number">@Model.Count(s => s.IsActive)</span>
        <span class="label">Active</span>
    </div>
    <div class="summary-item">
        <span class="number">@Model.Count(s => !s.IsActive)</span>
        <span class="label">Inactive</span>
    </div>
</div>

<div class="data-table-container" data-reveal>
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="data-row" data-status="@(item.IsActive ? "active" : "inactive")">
                        <td>
                            <div class="primary-info">
                                <div class="name">@item.Name</div>
                                <div class="secondary">@item.ContactPerson</div>
                            </div>
                        </td>
                        <td>
                            <div class="contact-info">
                                <div class="phone">@item.Phone</div>
                                <div class="email">@item.Email</div>
                            </div>
                        </td>
                        <td>
                            <span class="location">@item.City</span>
                        </td>
                        <td>
                            <span class="status-badge status-@(item.IsActive ? "active" : "inactive")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                @Html.ActionLink("View", "Details", new { id = item.SupplierId }, new { @class = "btn btn-sm btn-outline" })
                                @Html.ActionLink("Edit", "Edit", new { id = item.SupplierId }, new { @class = "btn btn-sm btn-outline" })
                                @Html.ActionLink("Delete", "Delete", new { id = item.SupplierId }, new { @class = "btn btn-sm btn-outline btn-danger" })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
